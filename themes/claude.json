{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": ["orange", "blue", "green", "purple", "yellow", "cyan", "red"],
    "text": {
      "base": "$hue.neutral.100",
      "muted": "$hue.neutral.200",
      "faint": "$hue.neutral.300",
      "action": {
        "primary": {
          "base": "$hue.accent.300",
          "$hovered": "$hue.accent.200",
          "$focused": "$hue.neutral.900",
          "$pressed": "$hue.neutral.100",
          "$selected": "$hue.neutral.100",
          "$disabled": "$hue.neutral.400"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base",
          "$focused": "$hue.neutral.100",
          "$pressed": "$hue.neutral.100",
          "$selected": "$hue.neutral.100",
          "$disabled": "$hue.neutral.400"
        },
        "destructive": {
          "base": "$hue.neutral.100",
          "$hovered": "$hue.neutral.100",
          "$focused": "$hue.neutral.100",
          "$pressed": "$hue.neutral.100",
          "$disabled": "$hue.neutral.400"
        }
      },
      "formfield": {
        "base": "$text.base",
        "$hovered": "$hue.interactive.300",
        "$focused": "$hue.interactive.300",
        "$pressed": "$hue.interactive.300",
        "$disabled": "$hue.neutral.400",
        "$selected": "$hue.interactive.300"
      },
      "feedback": {
        "error": {
          "base": "$hue.red.200"
        },
        "warning": {
          "base": "$hue.yellow.300"
        },
        "success": {
          "base": "$hue.green.300"
        },
        "info": {
          "base": "$hue.blue.300"
        }
      }
    },
    "background": {
      "base": "$hue.neutral.900",
      "raised": {
        "base": "$hue.neutral.700",
        "high": "$hue.neutral.600",
        "max": "$hue.neutral.500"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$hue.neutral.700",
          "$focused": "$hue.accent.400",
          "$pressed": "$hue.accent.600",
          "$selected": "$hue.interactive.600",
          "$disabled": "$hue.neutral.800"
        },
        "secondary": {
          "base": "transparent",
          "$hovered": "$hue.neutral.700",
          "$focused": "$hue.interactive.700",
          "$pressed": "$hue.neutral.700",
          "$selected": "$hue.interactive.600",
          "$disabled": "$hue.neutral.800"
        },
        "destructive": {
          "base": "$hue.red.600",
          "$hovered": "$hue.red.500",
          "$focused": "$hue.red.500",
          "$pressed": "$hue.red.700",
          "$disabled": "$hue.neutral.700"
        }
      },
      "formfield": {
        "base": "$background.base"
      },
      "feedback": {
        "error": {
          "base": "$background.base"
        },
        "warning": {
          "base": "$background.base"
        },
        "success": {
          "base": "$background.base"
        },
        "info": {
          "base": "$background.base"
        }
      }
    },
    "border": {
      "base": "$hue.neutral.400"
    },
    "scrollbar": {
      "base": "$hue.neutral.400"
    },
    "diff": {
      "text": {
        "added": "$hue.green.300",
        "removed": "$hue.red.300",
        "context": "$hue.neutral.300",
        "hunkHeader": "$hue.neutral.400"
      },
      "background": {
        "added": "$hue.green.900",
        "removed": "$hue.red.900",
        "context": "$hue.neutral.800"
      },
      "highlight": {
        "added": "$hue.green.200",
        "removed": "$hue.red.200"
      },
      "lineNumber": {
        "text": "$hue.neutral.300",
        "background": {
          "added": "$hue.green.800",
          "removed": "$hue.red.800"
        }
      }
    },
    "syntax": {
      "comment": "$hue.neutral.300",
      "keyword": "$hue.accent.300",
      "function": "$hue.blue.300",
      "variable": "$hue.purple.300",
      "string": "$hue.green.300",
      "number": "$hue.yellow.300",
      "type": "$hue.cyan.300",
      "operator": "$hue.neutral.200",
      "punctuation": "$hue.neutral.100"
    },
    "markdown": {
      "text": "$hue.neutral.100",
      "heading": "$hue.accent.300",
      "link": "$hue.blue.300",
      "linkText": "$hue.cyan.300",
      "code": "$hue.green.300",
      "blockQuote": "$hue.neutral.300",
      "emphasis": "$hue.purple.300",
      "strong": "$hue.yellow.300",
      "horizontalRule": "$hue.neutral.400",
      "listItem": "$hue.accent.300",
      "listEnumeration": "$hue.cyan.300",
      "image": "$hue.blue.300",
      "imageText": "$hue.cyan.300",
      "codeBlock": "$hue.green.300"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": {
            "$hovered": "$background.raised.high"
          },
          "secondary": {
            "$hovered": "$background.raised.high"
          }
        }
      }
    }
  },
